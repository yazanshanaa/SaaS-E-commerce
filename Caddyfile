# Souq Bartaa — reverse proxy.
#
# Two certificate strategies, deliberately different:
#   - platform hostnames ({slug}.$DOMAIN, admin, app) use ONE wildcard certificate obtained
#     through the Cloudflare DNS challenge (caddy-dns/cloudflare). Platform DNS lives on
#     Cloudflare for exactly this reason: an HTTP challenge cannot answer for a wildcard, and
#     issuing one certificate per storefront subdomain would burn the Let's Encrypt account
#     quota that every merchant on this box shares.
#   - merchant custom domains use on-demand TLS, gated by /internal/domain-ask so a stranger
#     pointing a CNAME at us cannot make us mint certificates and spend that same quota.
#
# Consequence for invariant 9: platform hostnames arrive through the Cloudflare proxy
# (CF-Connecting-IP is meaningful), merchant custom domains hit this server directly
# (only the socket IP is trustworthy). getClientIp() branches on precisely that.
#
# The full runbook — what the merchant types at their registrar, the Cloudflare grey-cloud rule,
# why apex is documented rather than supported, and how to read a failed issuance — is in
# docs/DOMAINS.md.

{
	email {$ACME_EMAIL}

	# --- on-demand TLS: the brake, not the door --------------------------------
	#
	# `ask` is consulted before Caddy will obtain a certificate for a hostname it has never seen.
	# The endpoint answers 200 only for a verified or active Domain row on a tenant that is not
	# being purged; a SUSPENDED tenant still passes, because its polite Arabic pause page has to
	# be served over valid HTTPS. See src/server/domains/ask.ts.
	#
	# `interval` and `burst` are the SECOND layer and they bound the damage from a bug in the
	# first: even if the ask endpoint were to start answering yes for everything — a schema
	# mistake, a database restored with the wrong rows — Caddy would still attempt at most 5 new
	# issuances per 2 minutes. Let's Encrypt's per-account limits are counted per week, so an
	# unbounded loop exhausts them long before anyone notices, and the recovery is measured in
	# days for EVERY merchant, not just the one that caused it.
	#
	# Caddy's `ask` takes a URL and nothing else — there is no header to carry a shared secret —
	# so the endpoint's protection is that it is not published outside the compose network. It is
	# written to be safe if reached anyway: it accepts only a hostname, reveals only what DNS
	# already does, and its single write is an idempotent status promotion.
	on_demand_tls {
		ask http://web:3000/internal/domain-ask
		interval 2m
		burst 5
	}
}

# --- platform hostnames: one wildcard cert via DNS challenge -------------------
*.{$DOMAIN}, {$DOMAIN} {
	tls {
		# Scoped token: Zone:DNS:Edit on this zone and nothing else. It can write the
		# _acme-challenge TXT record and cannot touch anything a compromise would want.
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}

	encode zstd gzip

	# Strict-Transport-Security lives HERE and nowhere else.
	#
	# It is a statement about TLS, and Caddy is the only process in this stack that terminates
	# TLS — the app is reached over plain HTTP inside the docker network, so a header it set
	# would be a promise made by something that has never seen a certificate. Caddy v2 does not
	# emit HSTS on its own, which is why this is written out rather than assumed.
	#
	# The preload flag is deliberately ABSENT. Submitting to the preload list is irreversible on a
	# browser timescale and it covers every subdomain — including a merchant custom domain that
	# has not been added yet. A two-year max-age with includeSubDomains is the strong part; the
	# preload flag is the part you cannot take back when a merchant leaves.
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"

	# The internal endpoints are not published, and THIS is what makes that true.
	#
	# Caddy matches a host-specific site block ahead of the port-only `:443` block below, so a
	# `handle /internal/*` written only down there covers merchant custom domains and nothing
	# else — leaving `/internal/domain-ask` and `/internal/revalidate` answering on
	# admin.$DOMAIN, app.$DOMAIN and every storefront subdomain. proxy.ts passes `/internal/*`
	# through without resolving a tenant or a session (it has to: the ask arrives for a hostname
	# we may not know yet), and the ask endpoint has no shared secret because Caddy's `ask`
	# directive sends no headers. So this block is not defence in depth for those two routes on
	# platform hostnames — it is the only layer they have.
	#
	# What was reachable without it: a status-code oracle over the whole `domains` table for any
	# hostname a stranger cares to name, and — for a row sitting at `verified` — an unauthenticated
	# GET that promotes it to `active` with no certificate ever issued.
	handle /internal/* {
		respond 404
	}

	# --- the three operations hostnames (Phase 7) -------------------------------
	#
	# They live INSIDE this site block rather than in blocks of their own, and that is a decision
	# rather than a shortcut. Caddy matches exactly one site block per request, so a separate block
	# would need its own copy of the wildcard `tls`, its own HSTS header and — the one that
	# matters — its own `handle /internal/*`. Three more copies of a 404 that is the ONLY layer
	# protecting the on-demand-TLS ask is three more places to forget it. Here they inherit all of
	# it, including the `/internal/*` refusal above, which is evaluated first.
	#
	# `basic_auth` in front of each is what Q9 means by "mandatory authentication": n8n and Uptime
	# Kuma both have their own user management, but both also expose a FIRST-RUN SETUP page, and
	# whoever reaches that page first becomes the owner. The window between `docker compose up` and
	# the operator's first login is the whole vulnerability, and it is the window a proxy password
	# closes. n8n's own accounts stay on underneath, because a shared password is not an identity.
	@n8n host n8n.{$DOMAIN}

	# Uptime Kuma is split for the same reason Umami is: two of its paths are the product working.
	#
	# `/api/push/{token}` is the ingest endpoint a push monitor exists for, and it is
	# unauthenticated BY DESIGN — the token in the URL is the credential. Behind basic auth it
	# answers 401 to a ping that carries no header, which does not merely disable the monitor: it
	# INVERTS it. Kuma alerts on silence, so a backup round that succeeded and then failed to ping
	# looks exactly like a backup that never ran, and the operator is paged by every healthy night
	# until they mute the one alert that would have told them the backups had stopped.
	@status_push {
		host status.{$DOMAIN}
		path /api/push/*
	}
	@status host status.{$DOMAIN}

	# Umami is split, because two of its paths are the product working.
	#
	# Every storefront loads the tracker from `umami.{$DOMAIN}/script.js` and reports to
	# `/api/send`. Putting basic auth over the whole hostname would return 401 to every visitor's
	# browser and silently end analytics for every merchant on the متجر and احترافي plans — while
	# the dashboard the operator checks kept working perfectly. Only these two paths are public;
	# the admin UI behind them is not.
	@umami_public {
		host umami.{$DOMAIN}
		path /script.js /api/send /api/send/*
	}
	@umami host umami.{$DOMAIN}

	handle @n8n {
		basic_auth {
			{$N8N_PROXY_AUTH_USER} {$N8N_PROXY_AUTH_HASH}
		}
		reverse_proxy n8n:5678
	}

	handle @umami_public {
		reverse_proxy umami:3000
	}

	handle @status_push {
		reverse_proxy uptime-kuma:3001
	}

	handle @umami {
		basic_auth {
			{$N8N_PROXY_AUTH_USER} {$N8N_PROXY_AUTH_HASH}
		}
		reverse_proxy umami:3000
	}

	handle @status {
		basic_auth {
			{$N8N_PROXY_AUTH_USER} {$N8N_PROXY_AUTH_HASH}
		}
		reverse_proxy uptime-kuma:3001
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

# --- merchant custom domains: on-demand TLS, refused unless verified -----------
:443 {
	tls {
		on_demand
	}

	encode zstd gzip

	# Strict-Transport-Security lives HERE and nowhere else.
	#
	# It is a statement about TLS, and Caddy is the only process in this stack that terminates
	# TLS — the app is reached over plain HTTP inside the docker network, so a header it set
	# would be a promise made by something that has never seen a certificate. Caddy v2 does not
	# emit HSTS on its own, which is why this is written out rather than assumed.
	#
	# The preload flag is deliberately ABSENT. Submitting to the preload list is irreversible on a
	# browser timescale, and it is not ours to submit — this block serves MERCHANT-OWNED domains.
	#
	# `includeSubDomains` is absent here too, and only here. On the platform block above it covers
	# hostnames we operate. On a merchant's own domain it would assert HSTS across subdomains we
	# have never seen and do not control — an office tool or a legacy host of theirs on plain HTTP
	# would become unreachable for two years because they pointed one CNAME at us.
	header Strict-Transport-Security "max-age=63072000"

	# Same block as the platform site above, and it has to be repeated rather than shared: Caddy
	# matches one site block per request, so a directive in the other one does not reach here.
	# `/internal/domain-ask` is how Caddy asks US a question; a visitor arriving on a merchant's
	# domain must not be able to ask it too, and `/internal/revalidate` would let anyone drop a
	# tenant's storefront cache.
	handle /internal/* {
		respond 404
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

# --- plain HTTP on a custom domain ---------------------------------------------
#
# Caddy redirects http -> https automatically for names it holds a certificate for. A custom
# domain that has NOT been verified holds none, so without this block the ACME HTTP-01 challenge
# and the merchant's own "why is my site down" visit both land on Caddy's default 404 with no
# explanation. Redirecting to HTTPS is the honest answer: either the certificate exists and the
# site loads, or it does not and the browser says so, which is a diagnosable state.
:80 {
	redir https://{host}{uri} 308
}
