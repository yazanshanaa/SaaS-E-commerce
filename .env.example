# =============================================================================
# Souq Bartaa — the FULL known environment surface.
#
# Invariant 7: a new env var and its line here land in the SAME commit. Parallel tracks are
# forbidden from editing this file (docs/PHASES.md), so everything Phases 1–6 are known to
# need is inventoried up front — including keys nothing reads yet (VAPID, Umami API,
# Cloudflare). A commented-out key is not "unused": it is a slot a later phase fills.
#
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Platform identity -------------------------------------------------------
# The domain is a PLACEHOLDER everywhere in code. Read it from here, never hardcode it.
DOMAIN=souqbartaa.test
# Scheme used to build absolute links (export links, emails, magic links).
PUBLIC_SCHEME=http
# Subdomain prefixes for the two private surfaces. Everything else is a storefront slug.
ADMIN_HOST_PREFIX=admin
APP_HOST_PREFIX=app
# Phase 11 (Q35): the platform's WhatsApp number, digits only with country code (e.g. 9725XXXXXXXX).
# The merchant subscription screen builds its renewal link from it; unset shows no link.
# Commented out rather than left blank — the same convention as DATABASE_URL_TEST below.
# PLATFORM_WHATSAPP_NUMBER=9725XXXXXXXX
NODE_ENV=development
TZ=Asia/Jerusalem
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# THREE roles, no BYPASSRLS on any of them (invariant 1).
#   app_web     — every HTTP request. Sees only what RLS lets the current GUCs see.
#   app_system  — sweeps and the outbox dispatcher. May read tenant ids, may not write
#                 tenant-owned tables; must fan out into per-tenant jobs.
#   app_migrate — owns the schema. Used by `prisma migrate` only, never by the app.
DATABASE_URL=postgresql://app_web:app_web@localhost:5432/souq_bartaa?schema=public
DATABASE_URL_SYSTEM=postgresql://app_system:app_system@localhost:5432/souq_bartaa?schema=public
DATABASE_URL_MIGRATE=postgresql://app_migrate:app_migrate@localhost:5432/souq_bartaa?schema=public
# Prisma needs a shadow database for `migrate dev` when the migrate role is not a superuser.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/souq_bartaa_shadow?schema=public
# Integration tests use this when set; otherwise they boot a private embedded cluster.
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/souq_bartaa_test?schema=public

# --- Redis (cache + BullMQ) --------------------------------------------------
REDIS_URL=redis://localhost:6379
# Separate logical DB indexes keep parallel worktrees from invalidating each other's caches.
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=0

# --- Auth --------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-base64
BETTER_AUTH_URL=http://app.souqbartaa.test:3000
# Session lifetime in seconds (7 days) and how often a live session is refreshed.
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
# Super admin bootstrap — read by `pnpm db:seed` only. Rotate after the first login.
SEED_SUPER_ADMIN_EMAIL=admin@souqbartaa.test
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026
SEED_SUPER_ADMIN_NAME=مدير المنصة
# Read by `pnpm db:seed:scenario` ONLY — the ten-merchant fixture (Phase 7). Production creates a
# merchant with no password at all and mails a reset link; the scenario sets one so the dashboards
# it builds can actually be opened. The script refuses to run under NODE_ENV=production.
SEED_MERCHANT_PASSWORD=Merchant!2026

# --- Encryption --------------------------------------------------------------
# One 32-byte base64 secret. Used for: AES-256-GCM field encryption (gateway keys),
# the HMAC behind DemoRequest.ipHash and TenantTombstone.slugHash. A bare hash of an IPv4
# address is brute-forceable over the whole address space, so an HMAC is not optional here.
# openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-32-bytes-of-base64

# --- Object storage: Cloudflare R2 (S3 API) ----------------------------------
# STORAGE_DRIVER=local is DEVELOPMENT ONLY. Production is always r2.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# E2E_ALLOW_LOCAL_STORAGE=1 lets the local driver run under NODE_ENV=production. It exists for ONE
# caller — playwright.config.ts, which runs the real production build against a temp directory —
# and is listed here so nobody has to discover it by grep. Leave it unset everywhere else: setting
# it on a deployment means serving merchant media off the app server's disk. Deliberately not
# given a value below, because there is no value a real environment should copy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=souq-bartaa
R2_REGION=auto
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public CDN in front of R2. Its origin is restricted to the media/ segment: an export
# artifact is a whole business in one file and must never be fetchable unsigned.
CDN_PUBLIC_BASE_URL=http://localhost:3000/dev-media
# Server-side encryption for the _exports/ prefix.
R2_SSE_ALGORITHM=AES256
# Signed URLs minted per request for export downloads. Hard ceiling: SigV4 caps presigned
# validity at 7 days, which is why Q18's 30-day promise is a platform route, not a presign.
EXPORT_SIGNED_URL_TTL_SECONDS=3600

# --- Mail --------------------------------------------------------------------
# resend | smtp — smtp is both the production fallback and the dev driver (mailpit).
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@souqbartaa.test
MAIL_FROM_NAME=سوق برطعة
MAIL_REPLY_TO=support@souqbartaa.test
RESEND_API_KEY=
# Dev: mailpit on localhost. See docs/EMAIL.md for SPF/DKIM/DMARC in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Analytics: self-hosted Umami -------------------------------------------
# One websiteId per tenant, provisioned at account creation (A1) — hence the API credentials.
UMAMI_BASE_URL=
UMAMI_SCRIPT_URL=
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
UMAMI_API_TOKEN=

# --- n8n / outbound webhooks -------------------------------------------------
N8N_BASE_URL=
N8N_WEBHOOK_URL=
# Every outbound webhook body is signed: X-Souq-Signature: sha256=<hmac>.
WEBHOOK_HMAC_SECRET=replace-me-with-32-bytes-of-base64
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
# n8n's own execution history is a PRIVACY surface, not just ops (Phase 6): it stores every node's
# input and output, which for this platform means delivered export links and merchant phone
# numbers — and Q9 puts n8n's database in the backup set. Prune it hard. These two are consumed by
# the n8n service in the production compose (Phase 7); they live here so the value is decided once
# and the compose has nothing to invent.
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_MAX_AGE=168
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# --- Sentry (SaaS, Q15) ------------------------------------------------------
# Wired in Phase 7. Setting a DSN turns three things on at once: error reporting from the web
# server, from the edge runtime and from the worker — and a Sentry line in EVERY tenant's
# generated Arabic privacy policy, because a configured processor has to be disclosed. Leaving it
# blank turns all four off. There is no state where data is sent and the policy stays silent.
SENTRY_DSN=
# NOT read by anything, and deliberately so. The browser SDK is not installed: it would make a
# visitor's browser contact a third party from a storefront that promises zero cross-origin
# requests before consent. Errors are captured server-side, where this platform renders anyway.
# Kept as a slot rather than deleted so nobody re-adds it without reading docs/DECISIONS.md.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Cloudflare --------------------------------------------------------------
# Scoped token, Zone:DNS:Edit only — used by caddy-dns/cloudflare for the wildcard cert.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# getClientIp() trusts CF-Connecting-IP only when the peer is inside Cloudflare's published
# ranges. Merchant custom domains bypass the proxy, so this must stay a per-request decision.
TRUST_CLOUDFLARE=true
CLOUDFLARE_RANGES_REFRESH_CRON=0 4 * * *

# --- Web Push (Phase 4, احترافي only) ----------------------------------------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# NOT read by anything, and deliberately so: the storefront is server-rendered, so the public
# key reaches the subscribe button as a PROP. A NEXT_PUBLIC_* variable would bake it into every
# client bundle at BUILD time, which means rotating the VAPID pair would need a rebuild rather
# than a restart — and a stale baked key produces subscriptions the sender can never push to.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The `mailto:` a push service contacts when deliveries to it start failing. Required by RFC 8292.
VAPID_SUBJECT=mailto:support@souqbartaa.test
# How long a push may wait on the vendor's server for a device that is offline. A shop offer is
# perishable: arriving four days late is worse than not arriving.
PUSH_TTL_SECONDS=86400
PUSH_SEND_CONCURRENCY=20

# --- Domains (Phase 4) -------------------------------------------------------
# Verification asks PUBLIC resolvers, never the container's: a caching resolver that already
# answered NXDOMAIN keeps answering it for the whole negative TTL, and the merchant who did
# everything right is told their DNS is wrong.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
DNS_TIMEOUT_MS=5000

# --- Internal service-to-service (worker -> web) -----------------------------
# The worker is a separate container, and Next's revalidateTag() only works inside the Next
# server. So the queue drops a tenant's storefront cache through POST /internal/revalidate.
# Point this at the WEB container from wherever the worker runs (compose: http://web:3000).
INTERNAL_BASE_URL=http://127.0.0.1:3000
# Shared secret for /internal/*. Optional in development, REQUIRED in production — the route
# refuses with 503 when it is unset there, rather than accepting a cache drop from anything
# that can reach the container. openssl rand -base64 32
INTERNAL_API_SECRET=
INTERNAL_REQUEST_TIMEOUT_MS=5000

# --- Lifecycle windows (Q6 / Q18) -------------------------------------------
# Days of retention after suspension before a purge. The admin can extend per tenant.
RETENTION_DAYS=30
# A DemoRequest that never becomes a demo is deleted after this many days.
DEMO_REQUEST_RETENTION_DAYS=30
# 03:00 Asia/Jerusalem daily sweep.
LIFECYCLE_SWEEP_CRON=0 3 * * *

# --- Retention for the records that OUTLIVE a tenant (Phase 6) ----------------
# The deletion record's own lifetime: TenantTombstone, platform_audit_logs and closed DsrRequest
# rows. They exist to prove a purge happened after everything that could have proved it is gone,
# so they cannot be short — but "forever" is not a retention policy, and the generated privacy
# page states this number. Two years comfortably outlasts the backup window the restore runbook
# replays purges against, and still ends.
TOMBSTONE_RETENTION_DAYS=730
# webhook_deliveries keeps a full copy of every event payload in a GLOBAL table — including a
# closed demo's identifiers. Nothing pruned it before Phase 6.
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# --- Backups (Q10) — POLICY here, MECHANISM in Phase 7 ------------------------
# src/server/legal interpolates both of these into every generated Arabic privacy policy AS FACT.
# There is no backup code in this repository yet, so they describe the operator's stated schedule —
# and they live in env precisely so the number the policy publishes and the number the deployment
# runs are the same value. Change the schedule, change these, and every tenant's policy follows.
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=14

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_PUBLIC_FORM_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_EXPORT_DOWNLOAD_PER_HOUR=20
# Each verify attempt is up to four live DNS queries against public resolvers.
RATE_LIMIT_DOMAIN_VERIFY_PER_HOUR=20
RATE_LIMIT_PUSH_SUBSCRIBE_PER_HOUR=20
# Per TENANT, per rolling day. Less an abuse control than a reputation one: a shop that pushes
# six times a day is a shop everyone mutes, at the OS level, where no merchant wins it back.
RATE_LIMIT_PUSH_SEND_PER_DAY=5
# A visitor placing an order, per tenant per IP per hour. The outer bound only — the ceiling that
# must not degrade when Redis blinks is counted off Order rows inside the checkout transaction.
RATE_LIMIT_CHECKOUT_PER_HOUR=10
# The self-serve export, per TENANT per day. The heaviest operation on the platform and the only
# channel authorised to carry customer names and phone numbers out of it (Phase 5, decision (a)).
RATE_LIMIT_SELF_SERVE_EXPORT_PER_DAY=10
# The consent banner's answer endpoint, per tenant per IP per ten minutes.
RATE_LIMIT_CONSENT_PER_10MIN=20
# The gateway settlement callback. Inert while every adapter is scaffolded; limited now because the
# day one is activated this route decrypts stored credentials before it verifies a signature.
RATE_LIMIT_GATEWAY_CALLBACK_PER_HOUR=120

# --- Phase 8: cart, checkout settings and coupons ----------------------------
# Cart checkout, per tenant per IP per hour and per tenant per PHONE per hour (item 4: "rate
# limited by IP + phone"). Outer, degradable bounds — the ceiling that must not degrade is
# MAX_CART_ORDERS_PER_TENANT_PER_HOUR, counted off Order rows inside the checkout transaction.
RATE_LIMIT_CART_CHECKOUT_PER_HOUR=20
RATE_LIMIT_CART_CHECKOUT_PER_PHONE_PER_HOUR=10
# The public tracking page (lookup, self-edit, self-cancel), per tenant per IP per hour — the
# route a phone-last-4 guess would be tried against.
RATE_LIMIT_ORDER_TRACKING_PER_HOUR=30

# --- Brute-force protection (Phase 6) ----------------------------------------
# The window limiter above bounds the RATE of credential guessing; these bound the TOTAL. Counted
# per email (hashed) so an attacker rotating addresses cannot walk past it — and expiring on its
# own so a merchant who genuinely forgot their password is not waiting on a support call.
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_MINUTES=15

# --- ACME (Caddy) ------------------------------------------------------------
ACME_EMAIL=admin@souqbartaa.test

# =============================================================================
# PRODUCTION ONLY (Phase 7) — read by docker-compose.prod.yml, not by src/env.ts
#
# Everything below configures the STACK rather than the application: database roles, the two
# side services and their databases, and the backup sidecar. `src/env.ts` never sees any of it,
# which is why none of it has a zod entry — the consumer is compose, and a missing value stops
# a container with `VARIABLE is required` rather than booting one with a guess.
#
# A development checkout needs none of these. Leave them as they are; docs/DEPLOY.md is the
# checklist that fills them in on the server.
# =============================================================================

# --- Postgres: the cluster and the four passwords ----------------------------
# The dev compose hardcodes each role's password to its own name. That is fine on a laptop and
# is exactly what must not ship, so production takes all four from here and
# docker/postgres/production-init refuses to initialise the cluster without them.
# openssl rand -base64 24   (four times, four different values)
POSTGRES_DB=souq_bartaa
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
APP_WEB_PASSWORD=
APP_SYSTEM_PASSWORD=
APP_MIGRATE_PASSWORD=

# --- Redis -------------------------------------------------------------------
# Unpublished, and still password-protected: it holds the entitlement cache, every rate-limit
# counter and every queued job payload — and those payloads carry tenantId.
REDIS_PASSWORD=

# --- n8n (Q9) ----------------------------------------------------------------
# Its OWN database in the same cluster, never a schema inside the application database.
N8N_DB_NAME=n8n
N8N_DB_PASSWORD=
# Encrypts credentials inside n8n's own database. Generate once and do not rotate casually:
# changing it orphans every credential already stored. openssl rand -base64 32
N8N_ENCRYPTION_KEY=
# Basic auth in front of n8n, Umami's admin UI and Uptime Kuma. All three ship a first-run setup
# page where whoever arrives first becomes the owner, and the window between `compose up` and
# your first login is the whole exposure.
#
# Generate the hash with:  docker run --rm caddy caddy hash-password --plaintext 'your-password'
#
# THEN DOUBLE EVERY `$` IN IT BEFORE PASTING IT HERE. Compose interpolates `$` inside .env
# values, so a bcrypt hash pasted verbatim arrives at Caddy mangled and every login fails with
# no indication why. `$2a$14$abc` becomes `$$2a$$14$$abc`.
N8N_PROXY_AUTH_USER=souq
N8N_PROXY_AUTH_HASH=

# --- Umami -------------------------------------------------------------------
# Its own database and owner too. UMAMI_BASE_URL / UMAMI_SCRIPT_URL above are derived from DOMAIN
# by the production compose — the script URL also drives the storefront CSP's script-src, so the
# hostname Caddy serves and the URL the policy allows cannot drift apart.
UMAMI_DB_NAME=umami
UMAMI_DB_PASSWORD=
# openssl rand -base64 32
UMAMI_APP_SECRET=

# --- Backups (Q10) — the MECHANISM. The POLICY is BACKUP_INTERVAL_HOURS above --
#
# A SEPARATE R2 bucket with SEPARATE credentials from the media bucket, deliberately. The media
# keys live in the web and worker containers, which are the ones exposed to the internet; a
# compromise there must not also hand over every historical dump of the whole platform.
R2_BACKUP_BUCKET=souq-bartaa-backups
# Defaults to R2_ENDPOINT when unset. Set it only if backups live in a different R2 account.
R2_BACKUP_ENDPOINT=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Comma-separated. Q9 and Q10 require the application database AND n8n's — losing n8n's database
# loses every WhatsApp automation, which no application backup contains. Umami's is included
# because it is the same loop and the same cluster.
BACKUP_DATABASES=souq_bartaa,n8n,umami
BACKUP_PREFIX=souq-bartaa
# The age PUBLIC key (age1...) backups are encrypted to. Generate the pair with `age-keygen`.
#
# THE MATCHING IDENTITY (AGE-SECRET-KEY-...) MUST NOT LIVE ON THIS SERVER. That is the entire
# point: with only the recipient here, someone who takes the box gets the live database — which
# they were always going to get — and NOT fourteen days of every tenant that has ever existed.
# Keep the identity in a password manager and mount it for the duration of a restore.
# The backup script refuses to start if this looks like an identity rather than a recipient.
BACKUP_AGE_RECIPIENT=
# Optional Uptime Kuma push-monitor URL, pinged ONLY on a fully successful round. A backup
# container that is running and failing every time looks healthy from the outside; this is what
# makes the difference visible. docs/DEPLOY.md -> Monitors.
BACKUP_HEARTBEAT_URL=

# --- Phase 10: the owner's backups screen (Q23) -------------------------------
#
# A THIRD credential pair, read-only, for the WEB container — so the screen at admin.{DOMAIN}/backups
# can list the sidecar's rounds and stream one dump. The pair above (R2_BACKUP_ACCESS_KEY_ID) can
# write and delete every historical dump of the platform, and the web container is the one process
# reachable from the internet: it must never hold those. Scope this pair to Object Read only.
#
# Leave both empty and the screen renders an honest "not configured" panel — which is the correct
# state until an R2 zone exists.
R2_BACKUP_READ_ACCESS_KEY_ID=
R2_BACKUP_READ_SECRET_ACCESS_KEY=
#
# The run-now control channel. The web container SETs {prefix}run-request; the backup sidecar polls
# it, deletes it, runs a round and writes {prefix}status back. A prefix rather than fixed key names
# so a staging stack sharing this Redis cannot trigger production's backup.
BACKUP_CONTROL_PREFIX=backup:

# --- Phase 10: the standalone bundle (Q25) ------------------------------------
#
# Where the worker image keeps the platform source tarball packed into an exported bundle. Produced
# by the `standalone-source` Dockerfile stage from the same context that built the running image, so
# a bundle ships exactly the code that built it. On a dev checkout the stage never ran and the export
# refuses with a clear Arabic message rather than shipping a bundle with no application in it.
STANDALONE_SOURCE_ARCHIVE=/opt/standalone/source.tar.gz
#
# SET ONLY INSIDE AN EXPORTED BUNDLE, NEVER ON THE PLATFORM. With the mode on, the root host serves
# ONE tenant's storefront, /dashboard serves its dashboard, the admin surface and every demo route
# 404, entitlements come from standalone/entitlements.json instead of plans, and the billing sweeps
# no-op. The bundle's own .env.template ships these filled in; here they are documented and empty.
SINGLE_TENANT_MODE=0
SINGLE_TENANT_ID=
