# dependencies
node_modules/
.pnpm-store/

# env — never committed (.env.example is the tracked surface)
.env
.env.*
!.env.example

# next
.next/
out/
next-env.d.ts

# build output
dist/
build/
*.tsbuildinfo

# tests
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# local runtime data
# Anchored with a leading slash: this is LOCAL_STORAGE_DIR (./storage), the dev disk driver's
# scratch directory. Unanchored, `storage/` also matched src/server/storage — so the entire
# StorageAdapter contract went uncommitted while still sitting in the working tree, and Phase 1
# passed its gate on files no clone would have had.
/storage/
.tmp/
# Every embedded-postgres data directory, present and future. `.pgdata-dev/` (scripts/dev-native.ts)
# was missing from this list — a complete database of every tenant's rows, one `git add .` away
# from a public repository. Caught in the 2026-08-21 security review; the glob closes the class.
.pgdata*/
.pgdata/
.pgdata-e2e/
seed-assets/**/*.jpg
seed-assets/**/*.png
seed-assets/**/*.webp

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local machine debris that shares this directory and is not part of the platform.
# `*.log` above already covers agent-report.log and the gate logs; these are the rest, named
# because the first `git add -A` after eighteen uncommitted days would otherwise have swept a
# folder of marketing video renders and three crash-diagnosis notes into the repository.
/itqan-reel-queenstyle/
/bsod-evidence.txt
/restart-diagnosis.txt
/wsl-check.txt
